{
  "name": "visiontv",
  "version": "1.0.1",
  "description": "VisionTV IPTV Player",
  "author": "Jsilverado2000",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "hls.js": "^1.6.15",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.visiontv.player",
    "productName": "VisionTV",
    "win": {
      "target": "nsis",
      "icon": "VisionTV.ico"
    },
    "nsis": {
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VisionTV"
    },
    "publish": {
      "provider": "github",
      "owner": "Jsilverado2000",
      "repo": "VisionTV"
    }
  }
}

